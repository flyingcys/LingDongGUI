  "forbid_v1_1_test_headers": [
    "picoui/picoui.h",
    "picoui/app.h",
    "picoui/native.h",
    "picoui/display.h",
    "picoui/port/sdl.h"
  ],
  "minimal_port_claims": [
    "picoui_sdl_hal_init",
    "picoui_port_sdl_default_pointer_indev",
